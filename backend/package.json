{
  "name": "medical-store-backend",
  "version": "1.0.0",
  "description": "Medical Store Wholesale Management — REST API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "prisma generate",
    "db:migrate": "node scripts/test-database.js --migrate",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:push": "node scripts/test-database.js --init",
    "db:seed": "node scripts/test-database.js --seed",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "test": "node --test test/*.test.js",
    "test:database": "node scripts/test-database.js",
    "db:migrate:test": "node scripts/test-database.js --migrate",
    "audit:discrepancies": "node scripts/discrepancies.js",
    "test:backup": "node scripts/test-database.js --backup"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
